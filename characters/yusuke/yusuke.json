  "moves": [
    {
      "id": "street_brawl_chain",
      "name": "Square Punch Chain",
      "input": "□ / Square",
      "type": "normal",
      "description": "Tap Square for jab, cross, body shot and uppercut. The first two presses deal normal damage. On the third consecutive press, the combo meter appears and damage starts multiplying."
    },
    {
      "id": "power_kick",
      "name": "Power Kick",
      "input": "△ / Triangle at ≤50% Spirit",
      "type": "normal",
      "description": "A free, spirit-enhanced kick with a new eight-frame animation that launches opponents backward and upward."
    },
    {
      "id": "spirit_shotgun",
      "name": "Spirit Shotgun",
      "input": "△ / Triangle at >50% Spirit",
      "type": "special",
      "description": "Triangle at strictly more than 50% Spirit: Yusuke gathers blue Spirit Energy around his fist and unleashes a blinding fan of seven damaging Spirit Shotgun pellets with forty visual-only fragments and clustered impacts. Costs 30 Spirit."
    },
    {
      "id": "spirit_gun",
      "name": "Spirit Gun",
      "input": "○ / L",
      "type": "special",
      "description": "Concentrates spirit energy in Yusuke's index finger, then releases a fast, compact energy bullet with a separate impact burst."
    },
    {
      "id": "spirit_dash",
      "name": "Spirit Dash",
      "input": "R1 / E",
      "type": "movement",
      "description": "Quick forward dash to close distance or extend pressure."
    },
    {
      "id": "spirit_charge",
      "name": "Spirit Charge",
      "input": "Hold L2 / I",
      "type": "utility",
      "description": "Stand and channel spirit energy; vulnerable while charging."
    },
    {
      "id": "maximum_spirit_gun",
      "name": "MAX Spirit Gun",
      "input": "R2 / U (100 meter)",
      "type": "super",
      "description": "Eight-hit cinematic spirit attack; requires full spirit meter."
    }
  ],
